# Django
# Generate with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do NOT use Django's get_random_secret_key(): its alphabet contains `#`, and
# django-environ truncates a value at the first `#` even inside quotes.
SECRET_KEY=replace-me-with-a-generated-secret-key
DEBUG=true
# Required when DEBUG=false. Comma separated.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me-with-a-strong-password
DATABASE_URL=psql://postgres:replace-me-with-a-strong-password@postgres_db:5432/genesis

# API
# Comma separated; leave empty in DEBUG to allow every origin.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
ANON_THROTTLE_RATE=120/min
API_CACHE_SECONDS=300

# HTTPS hardening (only applied when DEBUG=false)
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
